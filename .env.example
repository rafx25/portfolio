# ---------------------------------------------------------------------------
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# In production, set the same keys in the Vercel project settings.
# Never commit .env.local — it is git-ignored on purpose.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical links, sitemap.xml, robots.txt and
# Open Graph tags. No trailing slash.
# Local:      http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact form (optional)
#
# The contact form works without these: if RESEND_API_KEY is missing the API
# route returns a clear "email delivery is not configured" error and the UI
# falls back to a mailto link. Nothing crashes, nothing leaks.
# ---------------------------------------------------------------------------

# API key from https://resend.com (server-side only — never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=

# Verified sender address on your Resend domain.
# Resend's shared sandbox sender is onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Where contact form messages are delivered.
CONTACT_TO_EMAIL=
